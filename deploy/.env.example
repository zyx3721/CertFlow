SERVER_MODE=release
CORS_ORIGIN=*

DB_HOST=postgres
DB_PORT=5432
DB_NAME=certflow
DB_USER=postgres
DB_PASSWORD=123456ok!
DB_SSLMODE=disable

JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=12

# 登录失败锁定：同一账号连续密码失败达到次数后锁定，内置管理员 admin 不受限
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=2

# PKI 私钥加密。生产环境必须提供 Base64 编码的 32 字节随机密钥
# 生成方式：openssl rand -base64 32
PKI_KEY_ENCRYPTION_KEY=