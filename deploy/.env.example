SERVER_MODE=release
CORS_ORIGIN=*

DB_HOST=postgres
DB_PORT=5432
DB_NAME=certflow
DB_USER=postgres
DB_PASSWORD=123456ok!
DB_SSLMODE=disable

JWT_SECRET=change-me-in-production
# 会话有效期（小时），默认 12；本地密码、LDAP 与企业微信登录统一生效
JWT_EXPIRE_HOURS=12

# PKI 私钥加密。生产环境必须提供 Base64 编码的 32 字节随机密钥
# 生成方式：openssl rand -base64 32
PKI_KEY_ENCRYPTION_KEY=